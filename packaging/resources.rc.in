#include <windows.h>
1 RT_MANIFEST "@MC_MANIFEST_RESOURCE@"
101 RCDATA "@MC_PRESET_RESOURCE@"
102 RCDATA "@MC_LICENSE_RESOURCE@"
103 RCDATA "@MC_PROJECT_NOTICES_RESOURCE@"
104 RCDATA "@MC_PROJECT_LICENSE_RESOURCE@"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@MC_PREVIEW_REVISION@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@MC_PREVIEW_REVISION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x2
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "MotionCompensator"
      VALUE "FileVersion", "@MC_RELEASE_VERSION@"
      VALUE "ProductName", "MotionCompensator"
      VALUE "ProductVersion", "@MC_RELEASE_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
